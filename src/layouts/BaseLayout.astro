---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Flores del Rosario — Floristería Artesanal & Botánica',
  description = 'Ramos frescos, flores de estación, arreglos y materiales de jardinería elaborados con dedicación en Calbuco, Chile.',
  ogImage = '/assets/logo/flores_rosario_og.jpeg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://floresrosario.pages.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner container">
        <a href="/" class="brandmark" id="nav-brandmark">
          <svg class="sprig-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 0 1 10 10c0 5.5-4.5 10-10 10S2 17.5 2 12A10 10 0 0 1 12 2z"></path>
            <path d="M12 6v12"></path>
            <path d="m8 10 4-4 4 4"></path>
          </svg>
          <div class="names">
            <span class="n1">Flores del Rosario</span>
            <span class="n2">FLORISTERÍA & BOTÁNICA · CALBUCO</span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="desktop-nav" aria-label="Navegación principal">
          <a href="/" class="nav-link">Inicio</a>
          <a href="/productos" class="nav-link">Productos</a>
          <a href="/blog" class="nav-link">Blog</a>
          <a href="#contacto" class="nav-link">Contacto</a>
        </nav>

        <div class="header-actions">
          <a
            href="https://wa.me/56912345678"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp header-wa-btn"
            id="header-whatsapp-btn"
            aria-label="Contactar por WhatsApp"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 2C6.51 2 2.023 6.487 2.023 12.008c0 1.763.46 3.486 1.332 5.002L2 22l5.123-1.343a9.98 9.98 0 0 0 4.908 1.28h.004c5.518 0 10.005-4.487 10.005-10.008.001-2.674-1.038-5.187-2.928-7.078A9.94 9.94 0 0 0 12.031 2z"></path>
            </svg>
            <span class="wa-text">Pedir por WhatsApp</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer" id="contacto">
      <div class="container footer-content">
        <div class="footer-brand">
          <h3 class="footer-title">Flores del Rosario</h3>
          <p class="footer-desc">
            Floristería artesanal, arreglos florales, plantas y materiales de jardinería en Calbuco, Región de Los Lagos, Chile.
          </p>
        </div>
        <div class="footer-links">
          <h4>Navegación</h4>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/productos">Catálogo & Jardinería</a></li>
            <li><a href="/blog">Consejos Florales</a></li>
          </ul>
        </div>
        <div class="footer-contact">
          <h4>Contacto</h4>
          <p>Calbuco, Región de Los Lagos, Chile</p>
          <p>Lunes a Sábados: 9:00 a 19:00 hrs</p>
        </div>
      </div>
      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} Flores del Rosario. Todos los derechos reservados.</p>
        <p class="footer-tagline">Flores y botánica desde Calbuco para el sur de Chile</p>
      </div>

    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: var(--paper);
        border-bottom: 1px solid var(--line);
      }

      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 0.75rem;
        padding-bottom: 0.75rem;
      }

      .brandmark {
        display: flex;
        align-items: center;
        gap: 0.6rem;
      }

      .sprig-icon {
        width: 28px;
        height: 28px;
        color: var(--forest);
      }

      .names {
        display: flex;
        flex-direction: column;
        line-height: 1.1;
      }

      .n1 {
        font-family: var(--font-serif);
        font-weight: 600;
        font-size: 1.05rem;
        color: var(--forest);
      }

      .n2 {
        font-size: 0.62rem;
        letter-spacing: 0.05em;
        color: var(--ink-soft);
        font-weight: 600;
      }

      /* Navigation - Mobile First */
      .desktop-nav {
        display: none;
        gap: 1.8rem;
      }

      .nav-link {
        font-size: 0.92rem;
        font-weight: 600;
        color: var(--forest);
        transition: color var(--transition-fast);
      }

      .nav-link:hover {
        color: var(--leaf);
      }

      .wa-text {
        display: none;
      }

      .header-wa-btn {
        padding: 0.6rem 0.9rem;
      }

      @media (min-width: 768px) {
        .wa-text {
          display: inline;
        }
        .header-wa-btn {
          padding: 0.75rem 1.2rem;
        }
        .desktop-nav {
          display: flex;
        }
      }

      /* Footer */
      .site-footer {
        background-color: var(--forest);
        color: var(--cream-soft);
        padding-top: 3rem;
        padding-bottom: 2rem;
        margin-top: 4rem;
      }

      .footer-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }

      @media (min-width: 768px) {
        .footer-content {
          grid-template-columns: 1.4fr 1fr 1fr;
        }
      }

      .footer-title {
        color: var(--cream);
        font-size: 1.35rem;
        margin-bottom: 0.6rem;
      }

      .footer-desc {
        color: #CFE0D6;
        font-size: 0.88rem;
        line-height: 1.6;
      }

      .footer-links h4,
      .footer-contact h4 {
        color: var(--cream);
        font-size: 0.95rem;
        margin-bottom: 0.75rem;
      }

      .footer-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      .footer-links a {
        color: #CFE0D6;
        font-size: 0.86rem;
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--cream);
      }

      .footer-contact p {
        color: #CFE0D6;
        font-size: 0.86rem;
        line-height: 1.6;
      }

      .footer-bottom {
        border-top: 1px solid rgba(248, 223, 200, 0.18);
        margin-top: 2rem;
        padding-top: 1.2rem;
        font-size: 0.75rem;
        color: #9BB5A6;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
      }

      @media (min-width: 768px) {
        .footer-bottom {
          flex-direction: row;
          justify-content: space-between;
        }
      }
    </style>
  </body>
</html>
