---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { getSitioConfig } from '../lib/sanity.queries';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bannerAviso?: string;
}

const sitioConfig = await getSitioConfig();

const {
  title = `${sitioConfig.nombreNegocio} — ${sitioConfig.subtitulo}`,
  description = 'Ramos frescos, flores de estación, arreglos y materiales de jardinería elaborados con dedicación en Calbuco, Chile.',
  ogImage = '/assets/logo/flores_rosario_og.jpeg',
  bannerAviso,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://floresrosario.pages.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,600;0,9..144,700;1,9..144,400&family=Work+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Componente de Cabecera y Navegación Dinámica -->
    <Header currentPath={Astro.url.pathname} bannerAviso={bannerAviso} />

    <main id="main-content">
      <slot />
    </main>

    <!-- Pie de página Dinámico basado en Sanity CMS -->
    <footer class="site-footer" id="contacto">
      <div class="container footer-content">
        <div class="footer-brand">
          <div class="footer-brand-header">
            <img
              src="/assets/logo/flores_rosario.svg"
              alt="Logo"
              width="36"
              height="36"
              class="footer-logo"
            />
            <h3 class="footer-title">{sitioConfig.nombreNegocio}</h3>
          </div>
          <p class="footer-desc">
            Floristería artesanal, arreglos florales, plantas vivas y materiales de jardinería elaborados en Calbuco, Región de Los Lagos, Chile.
          </p>
          <div class="footer-socials">
            {
              sitioConfig.instagramUrl && (
                <a href={sitioConfig.instagramUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Instagram">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
                    <circle cx="12" cy="12" r="4"></circle>
                    <circle cx="17" cy="7" r="1.15" fill="currentColor"></circle>
                  </svg>
                </a>
              )
            }
            {
              sitioConfig.facebookUrl && (
                <a href={sitioConfig.facebookUrl} target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Facebook">
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="8.6"></circle>
                    <path d="M13.3 9.6h1.5V7.4h-1.6c-1.7 0-2.6 1-2.6 2.6v1.3H9v2.2h1.6v5.5h2.3v-5.5h1.7l.3-2.2h-2V10c0-.3.15-.4.4-.4Z" fill="currentColor" stroke="none"></path>
                  </svg>
                </a>
              )
            }
            <a
              href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(sitioConfig.mensajeWhatsAppDefault)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="icon-btn"
              aria-label="WhatsApp"
            >
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.031 2C6.51 2 2.023 6.487 2.023 12.008c0 1.763.46 3.486 1.332 5.002L2 22l5.123-1.343a9.98 9.98 0 0 0 4.908 1.28h.004c5.518 0 10.005-4.487 10.005-10.008.001-2.674-1.038-5.187-2.928-7.078A9.94 9.94 0 0 0 12.031 2z"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="footer-links">
          <h4>Navegación</h4>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/productos">Catálogo & Jardinería</a></li>
            <li><a href="/blog">Blog Botánico</a></li>
            <li><a href="/#historia">Nuestra Historia</a></li>
          </ul>
        </div>

        <div class="footer-contact">
          <h4>Contacto & Ubicación</h4>
          <p class="contact-line">{sitioConfig.direccion}</p>
          <p class="contact-line">{sitioConfig.horariosAtencion}</p>
          <p class="contact-line">
            WhatsApp: <a href={`https://wa.me/${sitioConfig.telefonoWhatsApp}`} class="wa-phone-link">+{sitioConfig.telefonoWhatsApp}</a>
          </p>
        </div>
      </div>

      <div class="container footer-bottom">
        <p>&copy; {new Date().getFullYear()} {sitioConfig.nombreNegocio}. Todos los derechos reservados.</p>
        <p class="footer-tagline">Flores y botánica desde Calbuco para el sur de Chile</p>
      </div>
    </footer>

    <style>
      /* Footer */
      .site-footer {
        background-color: var(--forest);
        color: var(--cream-soft);
        padding-top: 3.5rem;
        padding-bottom: 2rem;
        margin-top: 4rem;
        border-top: 1px solid rgba(248, 223, 200, 0.15);
      }

      .footer-content {
        display: grid;
        grid-template-columns: 1fr;
        gap: 2.5rem;
      }

      @media (min-width: 768px) {
        .footer-content {
          grid-template-columns: 1.5fr 1fr 1fr;
        }
      }

      .footer-brand-header {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.8rem;
      }

      .footer-title {
        color: var(--cream);
        font-size: 1.4rem;
      }

      .footer-desc {
        color: #cfe0d6;
        font-size: 0.88rem;
        line-height: 1.6;
        max-width: 26rem;
      }

      .footer-socials {
        display: flex;
        gap: 0.6rem;
        margin-top: 1.2rem;
      }

      .footer-socials .icon-btn {
        background: rgba(248, 223, 200, 0.14);
        color: var(--cream-soft);
      }

      .footer-socials .icon-btn:hover {
        background: var(--cream);
        color: var(--forest);
      }

      .footer-links h4,
      .footer-contact h4 {
        color: var(--cream);
        font-size: 0.98rem;
        margin-bottom: 0.85rem;
      }

      .footer-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
      }

      .footer-links a {
        color: #cfe0d6;
        font-size: 0.88rem;
        transition: color var(--transition-fast);
      }

      .footer-links a:hover {
        color: var(--cream);
      }

      .footer-contact .contact-line {
        color: #cfe0d6;
        font-size: 0.88rem;
        line-height: 1.65;
        margin-bottom: 0.35rem;
      }

      .wa-phone-link {
        color: var(--gold-soft);
        font-weight: 600;
        text-decoration: underline;
      }

      .footer-bottom {
        border-top: 1px solid rgba(248, 223, 200, 0.18);
        margin-top: 2.4rem;
        padding-top: 1.4rem;
        font-size: 0.78rem;
        color: #9bb5a6;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }

      @media (min-width: 768px) {
        .footer-bottom {
          flex-direction: row;
          justify-content: space-between;
        }
      }
    </style>
  </body>
</html>
