---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSitioConfig } from '../lib/sanity.queries';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';
import { ArrowRight, Compass } from '@lucide/astro';

const sitioConfig = await getSitioConfig();
---

<BaseLayout
  title={`Página no encontrada (404) — ${sitioConfig.nombreNegocio}`}
  description="La página que buscas no existe o ha sido movida. Te invitamos a regresar al inicio o descubrir nuestras flores y plantas en el catálogo."
>
  <section class="not-found-section">
    <div class="container not-found-container">
      <div class="not-found-card">
        <div class="icon-badge" aria-hidden="true">
          <Compass size={44} class="compass-icon" />
        </div>

        <span class="error-kicker">Error 404 · Fuera de sendero</span>
        <h1 class="error-title">Esta página no floreció por aquí</h1>

        <p class="error-text">
          Es posible que el enlace esté roto, la página haya cambiado de dirección o el producto ya no se encuentre disponible. Te invitamos a regresar al jardín principal o descubrir nuestras creaciones botánicas.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary btn-home">
            Volver al inicio
          </a>

          <a href="/productos" class="btn btn-outline btn-catalog">
            Ver catálogo <ArrowRight size={16} class="arrow" aria-hidden="true" />
          </a>
        </div>

        <div class="error-help">
          <span class="help-text">¿Buscabas algo específico o necesitas ayuda con un pedido?</span>
          <a
            href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Estaba navegando en el sitio web de Flores del Rosario y no encontré lo que buscaba.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="wa-help-link"
          >
            <WhatsAppIcon size={18} />
            Escríbenos por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-section {
    padding-top: calc(90px + 3rem);
    padding-bottom: 5rem;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--paper);
  }

  .not-found-container {
    max-width: 640px;
    margin: 0 auto;
  }

  .not-found-card {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: none;
    position: relative;
  }

  .icon-badge {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    background-color: var(--leaf-soft);
    color: var(--forest);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    border: 1px solid rgba(79, 122, 91, 0.25);
    box-shadow: var(--shadow-sm);
  }

  .compass-icon {
    stroke-width: 1.6;
  }

  .error-kicker {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--gold);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .error-title {
    font-size: clamp(1.8rem, 4.5vw, 2.4rem);
    color: var(--forest);
    line-height: 1.2;
    margin-bottom: 1.2rem;
  }

  .error-text {
    font-size: 1rem;
    color: var(--ink-soft);
    line-height: 1.65;
    margin-bottom: 2.2rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }

  .error-actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .btn-catalog {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .btn-catalog .arrow {
    transition: transform var(--transition-fast);
  }

  .btn-catalog:hover .arrow {
    transform: translateX(4px);
  }

  .error-help {
    padding-top: 1.8rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  .help-text {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .wa-help-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--forest);
    font-weight: 600;
    font-size: 0.92rem;
    transition: color var(--transition-fast);
  }

  .wa-help-link:hover {
    color: var(--leaf);
    text-decoration: underline;
  }

  @media (min-width: 768px) {
    .not-found-section {
      padding-top: calc(115px + 4rem);
      padding-bottom: 7rem;
    }

    .not-found-card {
      padding: 3.5rem 3rem;
    }

    .error-actions {
      flex-direction: row;
      gap: 1.2rem;
    }
  }
</style>
