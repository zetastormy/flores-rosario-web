---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticulos, getSitioConfig, type Articulo } from '../../lib/sanity.queries';
import { urlForImage } from '../../lib/sanity';

export async function getStaticPaths() {
  const articulos = await getArticulos();
  return articulos.map((articulo) => ({
    params: { slug: articulo.slug.current },
    props: { articulo },
  }));
}

interface Props {
  articulo: Articulo;
}

const { articulo } = Astro.props;
const sitioConfig = await getSitioConfig();
const todos = await getArticulos();

const relacionados = todos
  .filter((a) => a.slug.current !== articulo.slug.current)
  .slice(0, 2);

const shareUrl = new URL(Astro.url.pathname, Astro.site || 'https://floresrosario.pages.dev').toString();
const shareText = `Te comparto este artículo de Flores del Rosario: "${articulo.titulo}"`;
---

<BaseLayout
  title={`${articulo.titulo} — Blog de ${sitioConfig.nombreNegocio}`}
  description={articulo.resumen}
>
  <article class="article-detail-page">
    <!-- Portada Visual -->
    <div class={`article-cover-visual ${articulo.tone || 'tone-a'}`}>
      {
        articulo.imagenPortada ? (
          <img
            src={urlForImage(articulo.imagenPortada).width(1200).height(600).url()}
            alt={articulo.titulo}
            class="cover-img"
          />
        ) : (
          <div class="cover-placeholder">
            <span>Guía botánica · Flores del Rosario</span>
          </div>
        )
      }
    </div>

    <!-- Contenedor Editorial Central -->
    <div class="container article-container">
      <nav class="back-nav" aria-label="Navegación de retorno">
        <a href="/blog" class="back-link">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5"></path>
            <path d="m12 19-7-7 7-7"></path>
          </svg>
          Volver al blog
        </a>
      </nav>

      <header class="article-header">
        <div class="article-meta">
          {articulo.categoria && <span class="tag leaf">{articulo.categoria}</span>}
          <span class="meta-date">{articulo.fechaPublicacion}</span>
          <span class="meta-dot">·</span>
          <span class="meta-time">{articulo.tiempoLectura} de lectura</span>
        </div>

        <h1 class="article-headline">{articulo.titulo}</h1>

        <p class="article-lede">
          {articulo.resumen}
        </p>
      </header>

      <!-- Contenido Editorial -->
      <div class="article-content prose">
        <h3>Preparando el entorno para el clima del sur</h3>
        <p>
          En el sur de Chile y sus alrededores, las variaciones de humedad, viento y precipitaciones
          marcan los ciclos de la vegetación. Es fundamental elegir plantas adaptadas a suelos ricos en materia orgánica
          y proteger las especies más sensibles durante los cambios bruscos de temperatura.
        </p>

        <h3>El secreto de un sustrato saludable</h3>
        <p>
          Un buen drenaje es clave para evitar encharcamientos. La combinación de tierra de hojas, perlita y abono orgánico
          proporciona la oxigenación necesaria para que las raíces se desarrollen sin asfixia, tanto en canteros exteriores
          como en macetas de interior.
        </p>

        <h3>Riego y luminosidad</h3>
        <p>
          Durante los meses de primavera y verano, es conveniente regar a primera hora de la mañana o al atardecer para
          evitar la evaporación inmediata. En interiores, ubicar las plantas cerca de ventanas con luz difusa favorece una
          floración prolongada y hojas de verde intenso.
        </p>
      </div>

      <!-- Barra para Compartir -->
      <div class="share-bar">
        <span class="share-label">Comparte este artículo</span>
        <div class="share-actions">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${shareText} - ${shareUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="Compartir en WhatsApp"
            title="Compartir en WhatsApp"
          >
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 2C6.51 2 2.023 6.487 2.023 12.008c0 1.763.46 3.486 1.332 5.002L2 22l5.123-1.343a9.98 9.98 0 0 0 4.908 1.28h.004c5.518 0 10.005-4.487 10.005-10.008.001-2.674-1.038-5.187-2.928-7.078A9.94 9.94 0 0 0 12.031 2z"></path>
            </svg>
          </a>
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="icon-btn"
            aria-label="Compartir en Facebook"
            title="Compartir en Facebook"
          >
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="8.6"></circle>
              <path d="M13.3 9.6h1.5V7.4h-1.6c-1.7 0-2.6 1-2.6 2.6v1.3H9v2.2h1.6v5.5h2.3v-5.5h1.7l.3-2.2h-2V10c0-.3.15-.4.4-.4Z" fill="currentColor" stroke="none"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Caja de Asesoría WhatsApp -->
      <div class="article-support-box">
        <div class="sbox-copy">
          <h4>¿Necesitas flores frescas o herramientas para tu jardín?</h4>
          <p>
            En Flores del Rosario contamos con sustratos, macetas, herramientas y flores frescas con entregas en Puerto Montt y alrededores.
          </p>
        </div>
        <a
          href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(`¡Hola! Leí el artículo "${articulo.titulo}" y quisiera consultar por productos de jardinería.`)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          Consultar por WhatsApp
        </a>
      </div>

      <!-- Artículos Relacionados -->
      {
        relacionados.length > 0 && (
          <div class="more-articles-section">
            <h3>Sigue leyendo en nuestro blog</h3>
            <div class="more-grid">
              {
                relacionados.map((rel) => (
                  <a href={`/blog/${rel.slug.current}`} class="more-card">
                    <div class={`more-photo ${rel.tone || 'tone-b'}`}>
                      {rel.imagenPortada && (
                        <img
                          src={urlForImage(rel.imagenPortada).width(400).height(250).url()}
                          alt={rel.titulo}
                          class="more-img"
                          loading="lazy"
                        />
                      )}
                    </div>
                    <div class="more-body">
                      <span class="more-meta">{rel.fechaPublicacion}</span>
                      <h4>{rel.titulo}</h4>
                    </div>
                  </a>
                ))
              }
            </div>
          </div>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .article-detail-page {
    padding-bottom: 5rem;
  }

  /* Cover Visual */
  .article-cover-visual {
    width: 100%;
    height: clamp(240px, 35vw, 420px);
    position: relative;
    overflow: hidden;
  }

  .cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cover-placeholder {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 1.5rem 2rem;
    color: var(--paper);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.45) 0%, transparent 100%);
  }

  /* Editorial Container */
  .article-container {
    max-width: 760px;
    margin-top: -2.5rem;
    position: relative;
    background: var(--paper);
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    padding-top: 2rem;
    padding-bottom: 2rem;
  }

  .back-nav {
    margin-bottom: 1.2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--forest);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--leaf);
    transform: translateX(-3px);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.8rem;
    font-size: 0.84rem;
    color: var(--ink-soft);
  }

  .meta-dot {
    font-weight: 700;
  }

  .article-headline {
    font-size: clamp(2rem, 5.5vw, 2.9rem);
    line-height: 1.15;
    color: var(--forest);
    margin-bottom: 1.2rem;
  }

  .article-lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--forest-light);
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  /* Prose */
  .prose {
    font-size: 1.02rem;
    line-height: 1.75;
    color: var(--ink);
  }

  .prose h3 {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.7rem;
    color: var(--forest);
  }

  .prose p {
    margin-bottom: 1.4rem;
  }

  /* Share Bar */
  .share-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    margin-top: 2.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .share-label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
  }

  .share-actions {
    display: flex;
    gap: 0.6rem;
  }

  /* Support Box */
  .article-support-box {
    margin-top: 2.5rem;
    background-color: var(--leaf-soft);
    border-radius: var(--radius-lg);
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    border: 1px solid rgba(79, 122, 91, 0.25);
  }

  .sbox-copy h4 {
    font-size: 1.15rem;
    color: var(--forest);
    margin-bottom: 0.35rem;
  }

  .sbox-copy p {
    font-size: 0.88rem;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .article-support-box {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* More Articles */
  .more-articles-section {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .more-articles-section h3 {
    font-size: 1.25rem;
    margin-bottom: 1.5rem;
  }

  .more-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .more-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .more-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .more-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }

  .more-photo {
    height: 140px;
    position: relative;
    overflow: hidden;
  }

  .more-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .more-body {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .more-meta {
    font-size: 0.76rem;
    color: var(--ink-soft);
  }

  .more-body h4 {
    font-size: 0.98rem;
    color: var(--forest);
    line-height: 1.3;
  }

  /* Tone Gradients */
  .tone-a {
    background: linear-gradient(155deg, #7fa487 0%, #4f7a5b 55%, #2e5142 100%);
  }
  .tone-b {
    background: linear-gradient(155deg, #c9aed9 0%, #b79bc7 55%, #8b6d9d 100%);
  }
  .tone-c {
    background: linear-gradient(155deg, #e9c57a 0%, #d6a94a 55%, #a9793b 100%);
  }
  .tone-d {
    background: linear-gradient(155deg, #6d9481 0%, #3f6b54 55%, #1b4d3e 100%);
  }
</style>
