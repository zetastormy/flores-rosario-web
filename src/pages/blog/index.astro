---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticulos, getSitioConfig } from '../../lib/sanity.queries';
import { urlForImage } from '../../lib/sanity';

const articulos = await getArticulos();
const sitioConfig = await getSitioConfig();

const tagsBlog = ['Todos', 'Primavera', 'Verano', 'Otoño', 'Invierno', 'Cuidados generales'];
---

<BaseLayout
  title={`Blog & Consejos de Jardinería — ${sitioConfig.nombreNegocio}`}
  description="Guías botánicas, consejos de cultivo y cuidados para tus flores y plantas adaptadas al sur de Chile."
>
  <!-- Encabezado del Blog -->
  <section class="blog-header-section">
    <div class="container">
      <div class="bheader-content">
        <div class="eyebrow-mark">
          <svg class="sprig-mini" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 2a10 10 0 0 1 10 10c0 5.5-4.5 10-10 10S2 17.5 2 12A10 10 0 0 1 12 2z"></path>
            <path d="M12 6v12"></path>
            <path d="m8 10 4-4 4 4"></path>
          </svg>
          Temporada actual: Primavera en el Sur
        </div>
        <h1 class="bheader-title">Blog Botánico & Consejos</h1>
        <p class="bheader-desc">
          Aprende a cuidar tus flores frescas, preparar la tierra para cada estación y elegir las mejores plantas para tu hogar en el sur.
        </p>
      </div>
    </div>
  </section>

  <!-- Chips de Filtro por Época / Tema -->
  <div class="blog-filters-strip">
    <div class="container">
      <div class="chiprow" role="tablist" aria-label="Temas del blog">
        {
          tagsBlog.map((tag, idx) => (
            <button
              class={`chip blog-chip ${idx === 0 ? 'active' : ''}`}
              data-blog-tag={tag.toLowerCase()}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {tag}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Grilla de Artículos -->
  <section class="blog-list-section">
    <div class="container">
      <div class="blog-grid" id="blog-grid">
        {
          articulos.map((art) => (
            <article class="article-card" data-tag={art.categoria?.toLowerCase() || 'general'}>
              <a href={`/blog/${art.slug.current}`} class="acard-photo-wrap">
                <div class={`article-photo ${art.tone || 'tone-a'}`}>
                  {art.imagenPortada && (
                    <img
                      src={urlForImage(art.imagenPortada).width(500).height(320).url()}
                      alt={art.titulo}
                      class="acard-img"
                      loading="lazy"
                    />
                  )}
                  {art.categoria && <span class="tag leaf acard-tag">{art.categoria}</span>}
                </div>
              </a>

              <div class="article-body">
                <div class="article-meta">
                  <span class="meta-date">{art.fechaPublicacion}</span>
                  <span class="meta-dot">·</span>
                  <span class="meta-time">{art.tiempoLectura} de lectura</span>
                </div>

                <a href={`/blog/${art.slug.current}`}>
                  <h2 class="article-title">{art.titulo}</h2>
                </a>

                <p class="article-excerpt">{art.resumen}</p>

                <div class="article-footer">
                  <a href={`/blog/${art.slug.current}`} class="read-more-link">
                    Leer artículo completo &rarr;
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Banner de Llamada a la Acción al Pie del Blog -->
      <div class="blog-cta-banner">
        <div class="bcta-copy">
          <h3>¿Dudas con el cuidado de tus flores o plantas?</h3>
          <p>
            Escríbenos a nuestro WhatsApp y con gusto te asesoramos con recomendaciones personalizadas para el clima de la zona sur.
          </p>
        </div>
        <a
          href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Estuve leyendo el blog y tengo una duda sobre el cuidado de mis plantas.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.031 2C6.51 2 2.023 6.487 2.023 12.008c0 1.763.46 3.486 1.332 5.002L2 22l5.123-1.343a9.98 9.98 0 0 0 4.908 1.28h.004c5.518 0 10.005-4.487 10.005-10.008.001-2.674-1.038-5.187-2.928-7.078A9.94 9.94 0 0 0 12.031 2z"></path>
          </svg>
          Consultar por WhatsApp
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Header Section */
  .blog-header-section {
    padding-top: 2.5rem;
    padding-bottom: 2rem;
    background: linear-gradient(180deg, var(--cream) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--line);
  }

  .eyebrow-mark {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--gold);
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .bheader-title {
    font-size: clamp(2.1rem, 5vw, 3rem);
    line-height: 1.15;
  }

  .bheader-desc {
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.6;
    margin-top: 0.6rem;
    max-width: 36rem;
  }

  /* Filters */
  .blog-filters-strip {
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--paper);
  }

  .chiprow {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.2rem;
  }

  .chiprow::-webkit-scrollbar {
    display: none;
  }

  .blog-chip {
    flex: none;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.86rem;
    font-weight: 600;
    background: var(--paper);
    border: 1.5px solid var(--line);
    color: var(--ink-soft);
    transition: all var(--transition-fast);
  }

  .blog-chip.active {
    background: var(--forest);
    color: var(--cream);
    border-color: var(--forest);
  }

  /* Blog Grid */
  .blog-list-section {
    padding-top: 2.8rem;
    padding-bottom: 4.5rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.2rem;
    }
  }

  .article-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .article-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .article-photo {
    height: 200px;
    padding: 0.85rem;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }

  .acard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .acard-tag {
    position: relative;
    z-index: 2;
  }

  .article-body {
    padding: 1.3rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.6rem;
  }

  .article-meta {
    font-size: 0.78rem;
    color: var(--ink-soft);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .meta-dot {
    font-weight: 700;
  }

  .article-title {
    font-size: 1.22rem;
    line-height: 1.3;
    color: var(--forest);
    transition: color var(--transition-fast);
  }

  .article-title:hover {
    color: var(--leaf);
  }

  .article-excerpt {
    color: var(--ink-soft);
    font-size: 0.88rem;
    line-height: 1.6;
    flex: 1;
  }

  .article-footer {
    padding-top: 0.8rem;
    margin-top: 0.6rem;
    border-top: 1px solid var(--line);
  }

  .read-more-link {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--forest);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .read-more-link:hover {
    color: var(--leaf);
    transform: translateX(4px);
  }

  /* CTA Banner */
  .blog-cta-banner {
    margin-top: 4rem;
    background-color: var(--leaf-soft);
    border-radius: var(--radius-xl);
    padding: 2.2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    align-items: flex-start;
    border: 1px solid rgba(79, 122, 91, 0.25);
  }

  .bcta-copy h3 {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
  }

  .bcta-copy p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    line-height: 1.6;
    max-width: 36rem;
  }

  @media (min-width: 768px) {
    .blog-cta-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      padding: 2.8rem 3rem;
    }
  }

  /* Tone Gradients */
  .tone-a {
    background: linear-gradient(155deg, #7fa487 0%, #4f7a5b 55%, #2e5142 100%);
  }
  .tone-b {
    background: linear-gradient(155deg, #c9aed9 0%, #b79bc7 55%, #8b6d9d 100%);
  }
  .tone-c {
    background: linear-gradient(155deg, #e9c57a 0%, #d6a94a 55%, #a9793b 100%);
  }
  .tone-d {
    background: linear-gradient(155deg, #6d9481 0%, #3f6b54 55%, #1b4d3e 100%);
  }
</style>

<script>
  function setupBlogFiltering() {
    const chips = document.querySelectorAll('.blog-chip');
    const articles = document.querySelectorAll('.article-card') as NodeListOf<HTMLElement>;

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        chips.forEach((c) => {
          c.classList.remove('active');
          c.setAttribute('aria-selected', 'false');
        });
        chip.classList.add('active');
        chip.setAttribute('aria-selected', 'true');

        const selected = (chip as HTMLElement).dataset.blogTag || 'todos';

        articles.forEach((card) => {
          const cardTag = card.dataset.tag || '';
          if (selected === 'todos' || cardTag.includes(selected)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupBlogFiltering();
  document.addEventListener('astro:after-swap', setupBlogFiltering);
</script>
