---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getPaginaInicio,
  getProductosDestacados,
  getCategorias,
  getSitioConfig,
} from '../lib/sanity.queries';
import { urlForImage } from '../lib/sanity';
import WhatsAppIcon from '../components/icons/WhatsAppIcon.astro';

const paginaInicio = await getPaginaInicio();
const productosDestacados = await getProductosDestacados();
const categorias = await getCategorias();
const sitioConfig = await getSitioConfig();

// Formateador de moneda en pesos chilenos
const formatCLP = (amount: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(amount);
};
---

<BaseLayout
  title={`${sitioConfig.nombreNegocio} — ${sitioConfig.subtitulo}`}
  description={paginaInicio.heroBajada}
  bannerAviso={paginaInicio.bannerAviso}
>
  <!-- Hero Section (Mobile First) -->
  <section class="hero-section">
    <div class="container hero-layout">
      <div class="hero-content">
        <span class="eyebrow">{paginaInicio.heroKicker}</span>
        <h1 class="hero-title">{paginaInicio.heroTitulo}</h1>
        <p class="hero-lead">
          {paginaInicio.heroBajada}
        </p>
        <div class="hero-cta">
          <a href="#catalogo" class="btn btn-primary" id="btn-hero-catalogo">
            {paginaInicio.heroBotonCatalogo}
          </a>
          <a
            href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Quisiera consultar por un arreglo floral o materiales de jardinería con entrega en Puerto Montt o alrededores.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
            id="btn-hero-whatsapp"
          >
            {paginaInicio.heroBotonWhatsapp}
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-card tone-a">
          {
            paginaInicio.heroImagen && (
              <img
                src={urlForImage(paginaInicio.heroImagen).width(800).height(600).url()}
                alt={paginaInicio.heroTitulo}
                class="hero-img"
              />
            )
          }
          <div class="hero-card-inner">
            <span class="card-caption">{paginaInicio.heroCaption}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Categorías / Chips Dinámicos de Sanity -->
  <section class="categories-strip">
    <div class="container">
      <div class="chips-wrapper" role="tablist" aria-label="Categorías de productos">
        {
          categorias.map((cat, index) => (
            <a
              href={`/productos${cat.slug.current !== 'todas' ? `?categoria=${cat.slug.current}` : ''}`}
              class={`chip ${index === 0 ? 'active' : ''}`}
              id={`chip-${cat.slug.current}`}
            >
              {cat.nombre}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Catálogo de Destacados (Mobile-First Grid) -->
  <section class="products-section" id="catalogo">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-kicker">Catálogo & Botánica</span>
          <h2 class="section-title">Destacados de la Temporada</h2>
        </div>
        <a href="/productos" class="link-all-products">
          Ver todo el catálogo &rarr;
        </a>
      </div>

      <div class="products-grid">
        {
          productosDestacados.map((item) => (
            <article class="product-card">
              <div class={`product-photo ${item.tone || 'tone-a'}`}>
                {item.imagen && (
                  <img
                    src={urlForImage(item.imagen).width(400).height(300).url()}
                    alt={item.nombre}
                    class="pcard-img"
                  />
                )}
                {item.etiqueta && (
                  <span class={`tag ${item.tipoEtiqueta || ''}`}>{item.etiqueta}</span>
                )}
              </div>
              <div class="product-body">
                <h3 class="product-name">{item.nombre}</h3>
                <p class="product-desc">{item.descripcion}</p>
                <div class="product-footer">
                  <div class="price-wrap">
                    <span class="price">{formatCLP(item.precio)}</span>
                    {item.unidad && <span class="unit">{item.unidad}</span>}
                  </div>
                  <a
                    href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(`¡Hola! Quiero pedir el producto "${item.nombre}" (${formatCLP(item.precio)}). ¿Tienen disponibilidad de entrega en Puerto Montt o alrededores?`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-mini-wa"
                    aria-label={`Pedir ${item.nombre} por WhatsApp`}
                  >
                    <WhatsAppIcon size={18} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Banner Promocional Intermedio (Prototipo docs) -->
  <section class="promo-strip-section">
    <div class="container">
      <div class="promo-card-main">
        <div class="promo-copy">
          <h2>{paginaInicio.promoTitulo}</h2>
          <p>{paginaInicio.promoTexto}</p>
        </div>
        <a
          href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Quisiera consultar por disponibilidad y pedidos especiales en Flores del Rosario.')}`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp promo-btn"
        >
          <WhatsAppIcon size={20} />
          {paginaInicio.promoBoton}
        </a>
      </div>
    </div>
  </section>

  <!-- Historia & Compromiso Artesanal -->
  <section class="about-section" id="historia">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="about-photo-shape tone-b">
          {
            paginaInicio.historiaImagen && (
              <img
                src={urlForImage(paginaInicio.historiaImagen).width(500).height(600).url()}
                alt={paginaInicio.historiaTitulo}
                class="about-img"
              />
            )
          }
        </div>
      </div>
      <div class="about-content">
        <span class="section-kicker">{paginaInicio.historiaKicker}</span>
        <h2 class="section-title">{paginaInicio.historiaTitulo}</h2>
        <p class="about-text">
          {paginaInicio.historiaTexto}
        </p>
      </div>
    </div>
  </section>

  <!-- Floating Action Button WhatsApp (Mobile) -->
  <a
    href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(sitioConfig.mensajeWhatsAppDefault)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    aria-label="Abrir chat de WhatsApp para pedidos"
    id="whatsapp-floating-button"
  >
    <WhatsAppIcon size={28} />
  </a>
</BaseLayout>

<style>
  /* ==========================================================================
     Hero Section (Mobile-First)
     ========================================================================== */
  .hero-section {
    padding-top: 2.2rem;
    padding-bottom: 2.5rem;
    background: linear-gradient(180deg, var(--cream) 0%, var(--paper) 100%);
  }

  .hero-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--forest-light);
    font-size: 0.95rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .hero-title {
    font-size: clamp(2.1rem, 6.5vw, 3.4rem);
    font-weight: 600;
    color: var(--forest);
    line-height: 1.1;
  }

  .hero-lead {
    color: var(--ink-soft);
    font-size: 1.02rem;
    line-height: 1.65;
    margin-top: 0.9rem;
    max-width: 36rem;
  }

  .hero-cta {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }

  .hero-visual {
    width: 100%;
  }

  .hero-card {
    height: 240px;
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    box-shadow: var(--shadow-md);
  }

  .hero-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-card-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: 0.9rem 1.4rem;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.45) 0%, transparent 100%);
  }

  .card-caption {
    color: var(--paper);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.88rem;
  }

  @media (min-width: 768px) {
    .hero-section {
      padding-top: 4.5rem;
      padding-bottom: 4rem;
    }

    .hero-layout {
      display: grid;
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
      gap: 3.5rem;
    }

    .hero-card {
      height: 380px;
    }
  }

  /* ==========================================================================
     Chips Bar
     ========================================================================== */
  .categories-strip {
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .chips-wrapper {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.3rem;
  }

  .chips-wrapper::-webkit-scrollbar {
    display: none;
  }

  .chip {
    flex: none;
    padding: 0.55rem 1.2rem;
    border-radius: var(--radius-full);
    font-size: 0.88rem;
    font-weight: 600;
    background: var(--paper);
    border: 1.5px solid var(--line);
    color: var(--ink-soft);
    transition: all var(--transition-fast);
  }

  .chip:hover {
    border-color: var(--forest);
    color: var(--forest);
    transform: translateY(-1px);
  }

  .chip.active {
    background: var(--lilac);
    color: var(--forest);
    border-color: var(--lilac);
  }

  /* ==========================================================================
     Products Grid
     ========================================================================== */
  .products-section {
    padding-top: 3.5rem;
    padding-bottom: 3.5rem;
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .section-kicker {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--gold);
    font-size: 0.98rem;
    display: block;
    margin-bottom: 0.3rem;
  }

  .section-title {
    font-size: clamp(1.7rem, 4.5vw, 2.3rem);
  }

  .link-all-products {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--forest);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: color var(--transition-fast);
  }

  .link-all-products:hover {
    color: var(--leaf);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.6rem;
  }

  .product-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .product-photo {
    height: 190px;
    padding: 0.9rem;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .pcard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.5rem;
  }

  .product-name {
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .product-desc {
    color: var(--ink-soft);
    font-size: 0.86rem;
    line-height: 1.55;
    flex: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }

  .price-wrap {
    display: flex;
    flex-direction: column;
  }

  .price {
    font-weight: 700;
    color: var(--forest);
    font-size: 1.15rem;
  }

  .unit {
    font-size: 0.74rem;
    color: var(--ink-soft);
  }

  .btn-mini-wa {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--whatsapp-dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .btn-mini-wa:hover {
    transform: scale(1.1);
  }

  /* ==========================================================================
     Promo Card Main
     ========================================================================== */
  .promo-strip-section {
    padding-top: 1rem;
    padding-bottom: 2.5rem;
  }

  .promo-card-main {
    background-color: var(--leaf-soft);
    border-radius: var(--radius-xl);
    padding: 2.4rem 1.8rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
    border: 1px solid rgba(79, 122, 91, 0.2);
  }

  .promo-copy h2 {
    font-size: clamp(1.4rem, 3.5vw, 1.85rem);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .promo-copy p {
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.6;
    max-width: 34rem;
  }

  .promo-btn {
    padding: 0.85rem 1.6rem;
    font-size: 0.92rem;
  }

  @media (min-width: 768px) {
    .promo-card-main {
      padding: 3rem 3rem;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  /* ==========================================================================
     About Section
     ========================================================================== */
  .about-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
    background-color: var(--paper);
    border-top: 1px solid var(--line);
  }

  .about-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-visual {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .about-photo-shape {
    width: 240px;
    height: 260px;
    border-radius: 58% 42% 46% 54% / 54% 48% 52% 46%;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    position: relative;
  }

  .about-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-text {
    color: var(--ink);
    font-size: 0.98rem;
    line-height: 1.7;
    margin-top: 0.9rem;
    margin-bottom: 0;
    max-width: 34rem;
  }

  @media (min-width: 768px) {
    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1.3fr;
      align-items: center;
      gap: 4rem;
    }

    .about-photo-shape {
      width: 320px;
      height: 360px;
    }
  }

  /* Tone Gradients */
  .tone-a {
    background: linear-gradient(155deg, #7fa487 0%, #4f7a5b 55%, #2e5142 100%);
  }
  .tone-b {
    background: linear-gradient(155deg, #c9aed9 0%, #b79bc7 55%, #8b6d9d 100%);
  }
  .tone-c {
    background: linear-gradient(155deg, #e9c57a 0%, #d6a94a 55%, #a9793b 100%);
  }
  .tone-d {
    background: linear-gradient(155deg, #6d9481 0%, #3f6b54 55%, #1b4d3e 100%);
  }

  /* WhatsApp Floating Action Button */
  .whatsapp-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--whatsapp-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-fast), filter var(--transition-fast);
  }

  .whatsapp-fab:hover {
    transform: scale(1.08);
    filter: brightness(1.05);
  }
</style>
