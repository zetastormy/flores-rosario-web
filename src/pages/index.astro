<script>
  // Control de botones de flecha del carrusel de productos destacados
  const carousel = document.getElementById('featured-carousel');
  const prevBtn = document.getElementById('feat-prev-btn');
  const nextBtn = document.getElementById('feat-next-btn');

  if (carousel && prevBtn && nextBtn) {
    prevBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: -320, behavior: 'smooth' });
    });
    nextBtn.addEventListener('click', () => {
      carousel.scrollBy({ left: 320, behavior: 'smooth' });
    });
  }

  // Permitir ingresar al producto haciendo clic en cualquier parte de la tarjeta
  // sin interferir si se hace clic directamente en el botón de WhatsApp
  document.querySelectorAll('.featured-card').forEach((card) => {
    card.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target && !target.closest('.btn-mini-wa') && !target.closest('.card-click-overlay')) {
        const url = (card as HTMLElement).getAttribute('data-url');
        if (url) {
          window.location.href = url;
        }
      }
    });
  });
</script>
