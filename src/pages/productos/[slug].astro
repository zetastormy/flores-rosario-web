---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductos, getSitioConfig, type Producto } from '../../lib/sanity.queries';
import { urlForImage } from '../../lib/sanity';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { ArrowLeft, Sprout } from '@lucide/astro';

export async function getStaticPaths() {
  const productos = await getProductos();
  return productos.map((producto) => ({
    params: { slug: producto.slug.current },
    props: { producto },
  }));
}

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
const sitioConfig = await getSitioConfig();
const todos = await getProductos();

// Productos relacionados (misma categoría o diferentes del actual)
const relacionados = todos
  .filter((p) => p.slug.current !== producto.slug.current)
  .slice(0, 4);

const formatCLP = (amount: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(amount);
};

const waMessage = `¡Hola! Me interesa pedir "${producto.nombre}" (${formatCLP(producto.precio)}) con entrega en Puerto Montt o alrededores. ¿Tienen disponibilidad?`;
---

<BaseLayout
  title={`${producto.nombre} — ${sitioConfig.nombreNegocio}`}
  description={`${producto.descripcion.slice(0, 150)}... Pide directamente por WhatsApp con entregas en Puerto Montt y alrededores.`}
>
  <article class="product-detail-page">
    <div class="container detail-container">
      <!-- Navegación de Regreso -->
      <nav class="back-nav" aria-label="Navegación de retorno">
        <a href="/productos" class="back-link">
          <ArrowLeft size={18} aria-hidden="true" />
          Volver al catálogo
        </a>
      </nav>

      <!-- Layout Principal del Detalle (Columna Foto + Columna Información) -->
      <div class="product-detail-layout">
        <!-- Visual / Fotografía Principal -->
        <div class="pd-visual">
          <div class={`pd-photo-frame ${producto.tone || 'tone-a'}`}>
            {
              producto.imagen ? (
                <img
                  src={urlForImage(producto.imagen).width(700).height(600).url()}
                  alt={producto.nombre}
                  class="pd-main-img"
                />
              ) : (
                <div class="pd-caption-placeholder">
                  <span>Foto del producto</span>
                </div>
              )
            }
            {
              producto.etiqueta && (
                <span class={`tag ${producto.tipoEtiqueta || ''} pd-tag-floating`}>
                  {producto.etiqueta}
                </span>
              )
            }
          </div>
        </div>

        <!-- Información y Acciones de Compra -->
        <div class="pd-info">
          <div class="pd-header">
            <span class="pd-category">{producto.categoria?.nombre || 'Botánica & Floristería'}</span>
            <h1 class="pd-title">{producto.nombre}</h1>
          </div>

          <div class="pd-price-row">
            <span class="pd-price">{formatCLP(producto.precio)}</span>
            {producto.unidad && <span class="pd-unit">/ {producto.unidad}</span>}
          </div>

          <div class="pd-description">
            <p>{producto.descripcion}</p>
          </div>

          <!-- Cuidados o Especificaciones -->
          {
            producto.cuidados && (
              <div class="pd-care-box">
                <div class="care-icon-title">
                  <Sprout size={18} aria-hidden="true" />
                  <strong>Cuidados & Consejos</strong>
                </div>
                <p>{producto.cuidados}</p>
              </div>
            )
          }

          <!-- Botón de Pedido por WhatsApp -->
          <div class="pd-actions">
            <a
              href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(waMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-whatsapp btn-order-wa"
              id="btn-product-order-wa"
            >
              <WhatsAppIcon size={22} class="icon" />
              Pedir este producto por WhatsApp
            </a>
            <p class="pd-note">
              Entregas a domicilio en Puerto Montt y alrededores. La disponibilidad, personalización y horarios se confirman de forma inmediata por WhatsApp.
            </p>
          </div>
        </div>
      </div>

      <!-- Tira de Productos Relacionados -->
      {
        relacionados.length > 0 && (
          <section class="related-section">
            <div class="related-header">
              <span class="related-kicker">Recomendados para ti</span>
              <h2 class="related-title">También te puede interesar</h2>
            </div>

            <div class="related-grid">
              {
                relacionados.map((rel) => (
                  <a href={`/productos/${rel.slug.current}`} class="rel-card">
                    <div class={`rel-photo ${rel.tone || 'tone-b'}`}>
                      {rel.imagen && (
                        <img
                          src={urlForImage(rel.imagen).width(300).height(240).url()}
                          alt={rel.nombre}
                          class="rel-img"
                          loading="lazy"
                        />
                      )}
                      {rel.etiqueta && <span class="tag rel-tag">{rel.etiqueta}</span>}
                    </div>
                    <div class="rel-body">
                      <h3 class="rel-name">{rel.nombre}</h3>
                      <span class="rel-price">{formatCLP(rel.precio)}</span>
                    </div>
                  </a>
                ))
              }
            </div>
          </section>
        )
      }
    </div>
  </article>

  <!-- Botón Flotante WhatsApp -->
  <a
    href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(waMessage)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    aria-label="Pedir por WhatsApp"
  >
    <WhatsAppIcon size={28} />
  </a>
</BaseLayout>

<style>
  .product-detail-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  /* Back Link */
  .back-nav {
    margin-bottom: 1.5rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--forest);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .back-link:hover {
    color: var(--leaf);
    transform: translateX(-3px);
  }

  /* Detail Layout */
  .product-detail-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .product-detail-layout {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 3.5rem;
      align-items: flex-start;
    }
  }

  /* Visual Frame */
  .pd-visual {
    width: 100%;
  }

  .pd-photo-frame {
    width: 100%;
    aspect-ratio: 4 / 3.5;
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .pd-main-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pd-tag-floating {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    z-index: 5;
  }

  .pd-caption-placeholder {
    display: flex;
    align-items: flex-end;
    height: 100%;
    padding: 1rem 1.4rem;
    color: var(--paper);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.88rem;
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.4) 0%, transparent 100%);
  }

  /* Info Column */
  .pd-info {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pd-category {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--leaf);
    display: block;
    margin-bottom: 0.35rem;
  }

  .pd-title {
    font-size: clamp(2rem, 5vw, 2.7rem);
    line-height: 1.15;
    color: var(--forest);
  }

  .pd-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .pd-price {
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--forest);
  }

  .pd-unit {
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .pd-description p {
    font-size: 0.98rem;
    color: var(--ink);
    line-height: 1.7;
  }

  .pd-care-box {
    background-color: var(--leaf-soft);
    border: 1px solid rgba(79, 122, 91, 0.2);
    border-radius: var(--radius-md);
    padding: 1.1rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .care-icon-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--forest);
    font-size: 0.92rem;
  }

  .pd-care-box p {
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.6;
  }

  .pd-actions {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }

  .btn-order-wa {
    font-size: 1rem;
    padding: 1rem 1.6rem;
    width: 100%;
  }

  @media (min-width: 768px) {
    .btn-order-wa {
      width: fit-content;
    }
  }

  .pd-note {
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  /* Related Section */
  .related-section {
    margin-top: 4.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--line);
  }

  .related-header {
    margin-bottom: 1.8rem;
  }

  .related-kicker {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--gold);
    font-size: 0.92rem;
    display: block;
    margin-bottom: 0.25rem;
  }

  .related-title {
    font-size: clamp(1.4rem, 3.5vw, 1.8rem);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.4rem;
  }

  .rel-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .rel-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-sm);
  }

  .rel-photo {
    height: 140px;
    position: relative;
    padding: 0.7rem;
    overflow: hidden;
  }

  .rel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rel-tag {
    position: relative;
    z-index: 2;
  }

  .rel-body {
    padding: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .rel-name {
    font-size: 0.94rem;
    line-height: 1.25;
    color: var(--forest);
  }

  .rel-price {
    font-weight: 700;
    color: var(--forest);
    font-size: 0.98rem;
  }

  /* Tone Gradients */
  .tone-a {
    background: linear-gradient(155deg, #7fa487 0%, #4f7a5b 55%, #2e5142 100%);
  }
  .tone-b {
    background: linear-gradient(155deg, #c9aed9 0%, #b79bc7 55%, #8b6d9d 100%);
  }
  .tone-c {
    background: linear-gradient(155deg, #e9c57a 0%, #d6a94a 55%, #a9793b 100%);
  }
  .tone-d {
    background: linear-gradient(155deg, #6d9481 0%, #3f6b54 55%, #1b4d3e 100%);
  }

  /* WhatsApp FAB */
  .whatsapp-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--whatsapp-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-fast);
  }

  .whatsapp-fab:hover {
    transform: scale(1.08);
  }
</style>
