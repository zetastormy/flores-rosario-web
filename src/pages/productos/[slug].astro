<script define:vars={{ imagenesData }}>
  // Control interactivo de la galería de fotos y visor modal a tamaño completo
  let currentIndex = 0;

  const mainImg = document.getElementById('pd-active-img');
  const mainFrame = document.getElementById('pd-main-frame');
  const zoomBtn = document.getElementById('pd-zoom-btn');
  const thumbBtns = document.querySelectorAll('.pd-thumb-btn');

  const lightbox = document.getElementById('pd-lightbox');
  const backdrop = document.getElementById('lb-backdrop');
  const closeBtn = document.getElementById('lb-close-btn');
  const prevBtn = document.getElementById('lb-prev-btn');
  const nextBtn = document.getElementById('lb-next-btn');
  const lbFullImg = document.getElementById('lb-full-img');
  const lbCounter = document.getElementById('lb-counter');
  const lbThumbBtns = document.querySelectorAll('.lb-thumb-btn');

  let lastActiveElement = null;

  function updateActiveImage(index) {
    if (!imagenesData || imagenesData.length === 0) return;
    currentIndex = (index + imagenesData.length) % imagenesData.length;
    const current = imagenesData[currentIndex];

    // Actualizar vista previa en página de producto
    if (mainImg) {
      mainImg.src = current.mediumUrl;
      mainImg.alt = current.alt;
    }

    // Actualizar miniaturas de la página
    thumbBtns.forEach((btn, idx) => {
      if (idx === currentIndex) {
        btn.classList.add('active');
        btn.setAttribute('aria-current', 'true');
      } else {
        btn.classList.remove('active');
        btn.removeAttribute('aria-current');
      }
    });

    // Actualizar imagen grande en el Lightbox
    if (lbFullImg) {
      lbFullImg.src = current.fullUrl;
      lbFullImg.alt = current.alt;
    }
    if (lbCounter) {
      lbCounter.textContent = `${currentIndex + 1} / ${imagenesData.length}`;
    }

    // Actualizar miniaturas dentro del Lightbox
    lbThumbBtns.forEach((btn, idx) => {
      if (idx === currentIndex) {
        btn.classList.add('active');
        btn.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      } else {
        btn.classList.remove('active');
      }
    });
  }

  function openLightbox(index) {
    if (!lightbox) return;
    lastActiveElement = document.activeElement;
    if (typeof index === 'number') {
      updateActiveImage(index);
    }
    lightbox.removeAttribute('hidden');
    requestAnimationFrame(() => {
      lightbox.classList.add('is-open');
    });
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', onKeyDown);

    if (closeBtn) closeBtn.focus();
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove('is-open');
    setTimeout(() => {
      lightbox.setAttribute('hidden', '');
    }, 250);
    document.body.style.overflow = '';
    document.removeEventListener('keydown', onKeyDown);

    if (lastActiveElement && typeof lastActiveElement.focus === 'function') {
      lastActiveElement.focus();
    }
  }

  function onKeyDown(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    } else if (e.key === 'ArrowLeft') {
      updateActiveImage(currentIndex - 1);
    } else if (e.key === 'ArrowRight') {
      updateActiveImage(currentIndex + 1);
    }
  }

  // Event Listeners en miniaturas de la página
  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
      updateActiveImage(idx);
    });
  });

  // Abrir Lightbox al hacer clic en el botón de zoom o en el marco de la foto
  if (zoomBtn) {
    zoomBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(currentIndex);
    });
  }
  if (mainFrame) {
    mainFrame.addEventListener('click', () => {
      openLightbox(currentIndex);
    });
    mainFrame.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(currentIndex);
      }
    });
  }

  // Event Listeners dentro del Lightbox
  if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
  if (backdrop) backdrop.addEventListener('click', closeLightbox);
  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateActiveImage(currentIndex - 1);
    });
  }
  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      updateActiveImage(currentIndex + 1);
    });
  }

  lbThumbBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute('data-lb-index') || '0', 10);
      updateActiveImage(idx);
    });
  });

  // Gestos táctiles de desplazamiento (Swipe) en móvil
  let touchStartX = 0;
  let touchEndX = 0;
  if (lightbox) {
    lightbox.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    lightbox.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) {
          updateActiveImage(currentIndex + 1);
        } else {
          updateActiveImage(currentIndex - 1);
        }
      }
    }, { passive: true });
  }
</script>
