---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProductos, getCategorias, getSitioConfig } from '../../lib/sanity.queries';
import { urlForImage } from '../../lib/sanity';
import WhatsAppIcon from '../../components/icons/WhatsAppIcon.astro';
import { Search } from '@lucide/astro';

const productos = await getProductos();
const categorias = await getCategorias();
const sitioConfig = await getSitioConfig();

const formatCLP = (amount: number) => {
  return new Intl.NumberFormat('es-CL', {
    style: 'currency',
    currency: 'CLP',
    maximumFractionDigits: 0,
  }).format(amount);
};
---

<BaseLayout
  title={`Catálogo de Productos — ${sitioConfig.nombreNegocio}`}
  description="Explora nuestra selección de arreglos florales, flores frescas, plantas y materiales de jardinería. Entregas en Puerto Montt y alrededores."
>
  <!-- Encabezado de Página -->
  <section class="products-header-section">
    <div class="container">
      <div class="pheader-content">
        <div class="pheader-titles">
          <span class="eyebrow-kicker">Catálogo & Botánica · Entregas en Puerto Montt y alrededores</span>
          <h1 class="pheader-title">Nuestros Productos</h1>
          <p class="pheader-desc">
            Flores frescas de estación, plantas adaptadas al sur y materiales durables para tu jardín.
          </p>
        </div>

        <!-- Barra de Búsqueda -->
        <div class="search-box-wrapper">
          <div class="search-box" id="search-box">
            <Search size={18} class="search-icon" aria-hidden="true" />
            <input
              type="text"
              id="product-search-input"
              placeholder="Buscar flores, plantas, macetas..."
              aria-label="Buscar productos en el catálogo"
            />
            <button type="button" id="clear-search-btn" class="clear-btn" aria-label="Limpiar búsqueda" style="display:none;">
              &times;
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Chips de Categoría Móvil -->
  <div class="mobile-filter-chips">
    <div class="container">
      <div class="chiprow" role="tablist" aria-label="Filtrar por categoría">
        {
          categorias.map((cat, idx) => (
            <button
              class={`chip filter-chip ${idx === 0 ? 'active' : ''}`}
              data-cat-slug={cat.slug.current}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              {cat.nombre}
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Contenedor Principal: Sidebar en Desktop + Grid de Productos -->
  <section class="catalog-main-section">
    <div class="container catalog-layout">
      <!-- Filtros Laterales (Desktop) -->
      <aside class="desktop-sidebar-filters" aria-label="Filtros de categoría">
        <span class="filter-heading">Categorías</span>
        <div class="dfilters-list">
          {
            categorias.map((cat, idx) => (
              <button
                class={`dfilter-btn ${idx === 0 ? 'active' : ''}`}
                data-cat-slug={cat.slug.current}
              >
                <span>{cat.nombre}</span>
              </button>
            ))
          }
        </div>

        <!-- Tarjeta Promocional en Sidebar -->
        <div class="sidebar-promo-card tone-c">
          <span class="spromo-kicker">Atención especial</span>
          <h4>¿Buscas un arreglo personalizado?</h4>
          <p>Escríbenos directamente y preparamos un diseño único para tu ocasión.</p>
          <a
            href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Me gustaría cotizar un arreglo floral con entrega en Puerto Montt o alrededores.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-whatsapp btn-sidebar-wa"
          >
            <WhatsAppIcon size={18} />
            Consultar por WhatsApp
          </a>
        </div>
      </aside>

      <!-- Lista / Grilla de Productos -->
      <div class="catalog-products-area">
        <div class="results-meta">
          <span id="results-count">Mostrando {productos.length} productos</span>
        </div>

        <div class="catalog-grid" id="catalog-grid">
          {
            productos.map((item) => (
              <article
                class="product-card catalog-card"
                data-category={item.categoria?.slug.current || 'otros'}
                data-name={item.nombre.toLowerCase()}
                data-desc={item.descripcion.toLowerCase()}
              >
                <a href={`/productos/${item.slug.current}`} class="pcard-link-wrap">
                  <div class={`product-photo ${item.tone || 'tone-a'}`}>
                    {item.imagen && (
                      <img
                        src={urlForImage(item.imagen).width(400).height(300).url()}
                        alt={item.nombre}
                        class="pcard-img"
                        loading="lazy"
                      />
                    )}
                    {item.etiqueta && (
                      <span class={`tag ${item.tipoEtiqueta || ''}`}>{item.etiqueta}</span>
                    )}
                  </div>
                </a>

                <div class="product-body">
                  <span class="pcard-category-label">{item.categoria?.nombre || 'Botánica'}</span>
                  <a href={`/productos/${item.slug.current}`}>
                    <h3 class="product-name">{item.nombre}</h3>
                  </a>
                  <p class="product-desc">{item.descripcion}</p>

                  <div class="product-footer">
                    <div class="price-wrap">
                      <span class="price">{formatCLP(item.precio)}</span>
                      {item.unidad && <span class="unit">{item.unidad}</span>}
                    </div>

                    <a
                      href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent(`¡Hola! Quiero pedir el producto "${item.nombre}" (${formatCLP(item.precio)}). ¿Tienen disponibilidad de entrega en Puerto Montt o alrededores?`)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-mini-wa"
                      aria-label={`Pedir ${item.nombre} por WhatsApp`}
                      title="Pedir por WhatsApp"
                    >
                      <WhatsAppIcon size={18} />
                    </a>
                  </div>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Estado Vacío (Sin Resultados) -->
        <div id="empty-state" class="empty-state" style="display:none;">
          <div class="empty-icon">🌸</div>
          <h3>No encontramos productos</h3>
          <p>Prueba con otro término de búsqueda o selecciona otra categoría.</p>
          <button type="button" class="btn btn-ghost" id="reset-filters-btn">
            Restablecer filtros
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Botón Flotante WhatsApp -->
  <a
    href={`https://wa.me/${sitioConfig.telefonoWhatsApp}?text=${encodeURIComponent('¡Hola! Quisiera hacer un pedido del catálogo con entrega en Puerto Montt y alrededores.')}`}
    target="_blank"
    rel="noopener noreferrer"
    class="whatsapp-fab"
    aria-label="Contactar por WhatsApp"
  >
    <WhatsAppIcon size={28} />
  </a>
</BaseLayout>

<style>
  /* ==========================================================================
     Header Section
     ========================================================================== */
  .products-header-section {
    padding-top: 2.2rem;
    padding-bottom: 1.8rem;
    background: linear-gradient(180deg, var(--cream) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--line);
  }

  .pheader-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .eyebrow-kicker {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--forest-light);
    font-size: 0.94rem;
    display: block;
    margin-bottom: 0.35rem;
  }

  .pheader-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    line-height: 1.15;
  }

  .pheader-desc {
    color: var(--ink-soft);
    font-size: 0.96rem;
    line-height: 1.6;
    margin-top: 0.5rem;
    max-width: 34rem;
  }

  .search-box-wrapper {
    width: 100%;
    max-width: 420px;
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: var(--paper);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-full);
    padding: 0.7rem 1.1rem;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .search-box:focus-within {
    border-color: var(--forest);
    box-shadow: 0 0 0 3px rgba(27, 77, 62, 0.12);
  }

  .search-icon {
    color: var(--ink-soft);
    flex-shrink: 0;
  }

  .search-box input {
    border: none;
    background: transparent;
    outline: none;
    font-family: inherit;
    font-size: 0.92rem;
    color: var(--ink);
    width: 100%;
  }

  .clear-btn {
    border: none;
    background: none;
    color: var(--ink-soft);
    font-size: 1.3rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.2rem;
  }

  @media (min-width: 768px) {
    .products-header-section {
      padding-top: 3.2rem;
      padding-bottom: 2.5rem;
    }

    .pheader-content {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  /* ==========================================================================
     Mobile Filter Chips (Horizontal Scroll)
     ========================================================================== */
  .mobile-filter-chips {
    padding-top: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
    background-color: var(--paper);
  }

  .chiprow {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 0.2rem;
  }

  .chiprow::-webkit-scrollbar {
    display: none;
  }

  .filter-chip {
    flex: none;
    padding: 0.5rem 1.15rem;
    border-radius: var(--radius-full);
    font-size: 0.86rem;
    font-weight: 600;
    background: var(--paper);
    border: 1.5px solid var(--line);
    color: var(--ink-soft);
    transition: all var(--transition-fast);
  }

  .filter-chip.active {
    background: var(--forest);
    color: var(--cream);
    border-color: var(--forest);
  }

  @media (min-width: 1024px) {
    .mobile-filter-chips {
      display: none;
    }
  }

  /* ==========================================================================
     Catalog Main Layout (Desktop Sidebar + Grid)
     ========================================================================== */
  .catalog-main-section {
    padding-top: 2rem;
    padding-bottom: 4.5rem;
  }

  .catalog-layout {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (min-width: 1024px) {
    .catalog-layout {
      display: grid;
      grid-template-columns: 240px 1fr;
      gap: 3rem;
      align-items: flex-start;
    }
  }

  /* Desktop Sidebar */
  .desktop-sidebar-filters {
    display: none;
  }

  @media (min-width: 1024px) {
    .desktop-sidebar-filters {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      position: sticky;
      top: 90px;
    }
  }

  .filter-heading {
    font-family: var(--font-serif);
    font-weight: 600;
    color: var(--forest);
    font-size: 1.1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--line);
  }

  .dfilters-list {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .dfilter-btn {
    text-align: left;
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
    background: transparent;
    border: none;
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dfilter-btn:hover {
    background: var(--leaf-soft);
    color: var(--forest);
  }

  .dfilter-btn.active {
    background: var(--forest);
    color: var(--cream);
  }

  .sidebar-promo-card {
    padding: 1.4rem;
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    box-shadow: var(--shadow-sm);
  }

  .sidebar-promo-card.tone-c {
    background: linear-gradient(155deg, #fdf8eb 0%, #f7ebd4 100%);
    border: 1px solid rgba(214, 169, 74, 0.35);
  }

  .spromo-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    color: #7a5a1e;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .sidebar-promo-card h4 {
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--forest);
  }

  .sidebar-promo-card p {
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }

  .btn-sidebar-wa {
    font-size: 0.82rem;
    padding: 0.65rem 1rem;
    margin-top: 0.4rem;
  }

  /* Catalog Grid */
  .catalog-products-area {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .results-meta {
    font-size: 0.85rem;
    color: var(--ink-soft);
    font-weight: 500;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .catalog-card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .catalog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .pcard-link-wrap {
    display: block;
    position: relative;
  }

  .product-photo {
    height: 180px;
    padding: 0.85rem;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
  }

  .pcard-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-body {
    padding: 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.45rem;
  }

  .pcard-category-label {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--leaf);
  }

  .product-name {
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--forest);
    transition: color var(--transition-fast);
  }

  .product-name:hover {
    color: var(--leaf);
  }

  .product-desc {
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.5;
    flex: 1;
  }

  .product-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.8rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }

  .price-wrap {
    display: flex;
    flex-direction: column;
  }

  .price {
    font-weight: 700;
    color: var(--forest);
    font-size: 1.12rem;
  }

  .unit {
    font-size: 0.74rem;
    color: var(--ink-soft);
  }

  .btn-mini-wa {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--whatsapp-dark);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast);
  }

  .btn-mini-wa:hover {
    transform: scale(1.1);
  }

  /* Empty State */
  .empty-state {
    text-align: center;
    padding: 4rem 1.5rem;
    background-color: var(--leaf-soft);
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
  }

  .empty-icon {
    font-size: 2.8rem;
    margin-bottom: 0.8rem;
  }

  .empty-state h3 {
    font-size: 1.35rem;
    margin-bottom: 0.4rem;
  }

  .empty-state p {
    color: var(--ink-soft);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  /* Tone Gradients */
  .tone-a {
    background: linear-gradient(155deg, #7fa487 0%, #4f7a5b 55%, #2e5142 100%);
  }
  .tone-b {
    background: linear-gradient(155deg, #c9aed9 0%, #b79bc7 55%, #8b6d9d 100%);
  }
  .tone-c {
    background: linear-gradient(155deg, #e9c57a 0%, #d6a94a 55%, #a9793b 100%);
  }
  .tone-d {
    background: linear-gradient(155deg, #6d9481 0%, #3f6b54 55%, #1b4d3e 100%);
  }

  /* WhatsApp FAB */
  .whatsapp-fab {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--whatsapp-dark);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-fast);
  }

  .whatsapp-fab:hover {
    transform: scale(1.08);
  }
</style>

<script>
  function setupCatalogFiltering() {
    const searchInput = document.getElementById('product-search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('clear-search-btn');
    const mobileChips = document.querySelectorAll('.filter-chip');
    const desktopButtons = document.querySelectorAll('.dfilter-btn');
    const productCards = document.querySelectorAll('.catalog-card') as NodeListOf<HTMLElement>;
    const resultsCount = document.getElementById('results-count');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filters-btn');

    let currentCategory = 'todas';
    let currentSearchTerm = '';

    // Leer parámetro URL si existe (?categoria=...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('categoria');
    if (initialCategory) {
      currentCategory = initialCategory;
      updateActiveButtons(initialCategory);
    }

    function updateActiveButtons(categorySlug: string) {
      mobileChips.forEach((chip) => {
        const isMatch = (chip as HTMLElement).dataset.catSlug === categorySlug;
        chip.classList.toggle('active', isMatch);
        chip.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      });

      desktopButtons.forEach((btn) => {
        const isMatch = (btn as HTMLElement).dataset.catSlug === categorySlug;
        btn.classList.toggle('active', isMatch);
      });
    }

    function filterProducts() {
      let visibleCount = 0;

      productCards.forEach((card) => {
        const cardCategory = card.dataset.category || '';
        const cardName = card.dataset.name || '';
        const cardDesc = card.dataset.desc || '';

        const matchesCategory = currentCategory === 'todas' || cardCategory === currentCategory;
        const matchesSearch =
          !currentSearchTerm ||
          cardName.includes(currentSearchTerm) ||
          cardDesc.includes(currentSearchTerm);

        if (matchesCategory && matchesSearch) {
          card.style.display = '';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (resultsCount) {
        resultsCount.textContent = `Mostrando ${visibleCount} ${visibleCount === 1 ? 'producto' : 'productos'}`;
      }

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    function setCategory(categorySlug: string) {
      currentCategory = categorySlug;
      updateActiveButtons(categorySlug);
      filterProducts();
    }

    mobileChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const slug = (chip as HTMLElement).dataset.catSlug || 'todas';
        setCategory(slug);
      });
    });

    desktopButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const slug = (btn as HTMLElement).dataset.catSlug || 'todas';
        setCategory(slug);
      });
    });

    searchInput?.addEventListener('input', (e) => {
      const val = (e.target as HTMLInputElement).value.trim().toLowerCase();
      currentSearchTerm = val;
      if (clearBtn) {
        clearBtn.style.display = val ? 'inline' : 'none';
      }
      filterProducts();
    });

    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
      }
      currentSearchTerm = '';
      clearBtn.style.display = 'none';
      filterProducts();
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
      }
      currentSearchTerm = '';
      if (clearBtn) {
        clearBtn.style.display = 'none';
      }
      setCategory('todas');
    });

    // Ejecutar filtro inicial
    filterProducts();
  }

  setupCatalogFiltering();
  document.addEventListener('astro:after-swap', setupCatalogFiltering);
</script>
